{
  "name": "relay-dsh-plugin-semantic-router",
  "version": "0.2.1",
  "description": "Recall-oriented semantic Event router for Relay Events on DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "semantic-routing",
    "events"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/host-plugin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-semantic-router.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "prepare:dsh": "scripts/link-dsh-development-peers.sh",
    "pretest": "npm run prepare:dsh",
    "prebuild": "npm run prepare:dsh && node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "node --check host-plugin.js && node --check src/dsh-llm-adapter.mjs && node --check src/semantic.mjs && node --check src/evaluation.mjs && node --check scripts/evaluate-quality.mjs",
    "evaluate": "node scripts/evaluate-quality.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run evaluate && npm run build && npm pack --dry-run"
  },
  "exports": {
    ".": "./lib/host-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.zh.md",
    "README.md",
    "SPEC.md",
    "docs",
    "fixtures",
    "scripts/evaluate-quality.mjs",
    "cordis.patch.yml",
    "lib/host-plugin.js",
    "lib/host-plugin.js.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.2 <0.1.3-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "relay-dsh-plugin-events": "0.2.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "relay-dsh-plugin-events": {
      "optional": true
    }
  },
  "devDependencies": {
    "relay-dsh-plugin-events": "github:yangbobo2021/relay-dsh-plugin-events#1c320df544a7088b9ee3238ebeb6f90fa8f37979",
    "tsdown": "0.22.2"
  }
}
